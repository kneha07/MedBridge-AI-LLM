# Choose the model provider for both the workflow agent and the chatbot: groq (default), claude or bedrock.
# AI_PROVIDER=groq

# Groq (free tier is rate limited)
GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Claude through the Anthropic API
# AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Claude (or other models) on Amazon Bedrock, via the bedrock-runtime endpoint
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6   # inference profile ID: Bedrock console > Infer > Inference profiles
# AWS_BEARER_TOKEN_BEDROCK=                      # Bedrock long-term API key

GEMINI_API_KEY=

# Demo sign-in with two roles is ON by default, with public demo accounts alice (reviewer, PIN 2468) and bob (staff, PIN 1357).
# Roles: staff (prepare requests, chat) and reviewer (also approve or reject). Prototype control only.
# MEDBRIDGE_AUTH=off                      # turn sign-in off
# MEDBRIDGE_USERS=carol:reviewer:9876     # name:role:pin, comma separated; replaces the demo accounts
# MEDBRIDGE_SECRET=change-me-to-a-long-random-string
# MEDBRIDGE_DB=/path/to/another.db        # use a different SQLite file than backend/medbridge.db
