# Choose the model provider for both the workflow agent and the chatbot: groq (default), claude or bedrock.
# AI_PROVIDER=groq

# Groq (free tier is rate limited)
GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Claude through the Anthropic API
# AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Claude (or other models) on Amazon Bedrock, via the bedrock-runtime endpoint
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6   # inference profile ID: Bedrock console > Infer > Inference profiles
# AWS_BEARER_TOKEN_BEDROCK=                      # Bedrock long-term API key

GEMINI_API_KEY=
